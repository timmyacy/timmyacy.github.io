{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "timmy-portfolio": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/timmy-portfolio",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "polyfills": ["zone.js"],
            "styles": ["src/styles.scss"],
            "assets": [
              { "glob": "favicon.svg", "input": "src", "output": "/" },
              { "glob": "cv.txt", "input": "src/assets", "output": "/" },
              { "glob": "cv.pdf", "input": "src/assets", "output": "/" },
              { "glob": "profile", "input": "src/assets/v1", "output": "/v1" }
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "500kb", "maximumError": "1mb" }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "timmy-portfolio:build:production" },
            "development": { "buildTarget": "timmy-portfolio:build" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
